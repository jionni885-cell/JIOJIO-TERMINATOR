# =========================================================================== #
# JIOJIO-TERMINATOR — configuration
#
# AUCUNE de ces variables n'est obligatoire. Sans rien configurer, le systeme
# fonctionne en simulation deterministe : les reponses sont simulees, la
# VERIFICATION est reelle. C'est ce qui permet de tout tester sans cle.
#
# Copiez ce fichier en `.env` et decommentez ce que vous utilisez.
# Le fichier `.env` ne doit JAMAIS etre commite (deja dans .gitignore).
# =========================================================================== #

# --------------------------------------------------------------------------- #
# 1. CLI externes (recommande : ce sont vos agents deja authentifies)
#
#    Rien a configurer ici. JIO detecte automatiquement les binaires presents
#    dans le PATH et les utilise en subprocess. Pour connaitre ceux qui sont
#    connus :
#        jio doctor
# --------------------------------------------------------------------------- #
#
#   opencode   ->  opencode run "<prompt>" --format json --agent jio
#   hermes     ->  hermes chat -q "<prompt>"
#   claude     ->  claude -p "<prompt>"
#   codex      ->  codex exec "<prompt>"
#   gemini     ->  gemini -p "<prompt>"
#   aider      ->  aider --message "<prompt>" --yes
#
#   Les agents et competences JIO correspondants sont generes par :
#        jio artifacts --write
#
#   Surcharge du chemin d'un binaire (si hors PATH) :
# JIO_BIN_OPENCODE=/usr/local/bin/opencode
# JIO_BIN_HERMES=/opt/hermes/bin/hermes
#
#   Un outil INCONNU reste utilisable : donnez sa ligne de commande, avec `{prompt}` la
#   ou doit aller l'invite. Sans `{prompt}`, l'invite part sur l'entree standard (plus sur
#   avec les invites longues et les caracteres speciaux) :
# JIO_CLI_MON_OUTIL_ARGV=mon-outil run {prompt}
#
#   Deux FAMILLES sont reconnues, pour n'importe quel outil : JIO_BIN_<NOM> (chemin du
#   binaire) et JIO_CLI_<NOM>_ARGV (sa ligne de commande). <NOM> est le nom de l'outil en
#   majuscules, les tirets remplaces par des soulignes (`faux-modele` -> FAUX_MODELE) :
#   un tiret est interdit dans un nom de variable de shell.

# --------------------------------------------------------------------------- #
# 2. API compatible OpenAI — couvre la quasi-totalite des fournisseurs
#
#    OpenRouter, OpenAI, DeepSeek, Groq, Together, vLLM, LM Studio, Ollama…
#    Il suffit de trois valeurs : base, cle, modele.
# --------------------------------------------------------------------------- #
# JIO_OPENAI_BASE=https://openrouter.ai/api/v1
# JIO_OPENAI_KEY=sk-or-v1-...
# JIO_OPENAI_MODEL=anthropic/claude-sonnet-4.5
#
# JIO_OPENAI_BASE=https://api.openai.com/v1
# JIO_OPENAI_KEY=sk-...
# JIO_OPENAI_MODEL=gpt-5.4
#
# JIO_OPENAI_BASE=https://api.deepseek.com/v1
# JIO_OPENAI_KEY=sk-...
# JIO_OPENAI_MODEL=deepseek-chat

# --------------------------------------------------------------------------- #
# 3. Modele LOCAL (Ollama, LM Studio, llama.cpp)
#
#    Aucune cle necessaire. C'est le mode le moins cher a l'usage et celui ou
#    le harness apporte le PLUS de gain : plus le modele est faible, plus la
#    verification vaut cher. C'est la promesse centrale du projet.
# --------------------------------------------------------------------------- #
# JIO_OLLAMA=http://localhost:11434/v1
# JIO_OPENAI_MODEL=qwen3:14b
#
# JIO_OLLAMA=http://localhost:1234/v1        # LM Studio
# JIO_OPENAI_MODEL=local-model

# --------------------------------------------------------------------------- #
# 4. Cles reconnues automatiquement (si vous preferiez les conventions usuelles)
#
#    Depuis JIO_OPENAI_BASE, l'une de ces cles suffit :
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=

# --------------------------------------------------------------------------- #
# 5. Reglages du harness
# --------------------------------------------------------------------------- #

# Risque d'erreur accepte par la porte conforme (alpha). 0.05 = 5 %.
# Plus petit = plus d'abstentions, plus de garantie.
# JIO_ALPHA=0.05

# Nombre de tours maximum de la boucle de correction.
# JIO_MAX_ROUNDS=5

# Candidats generes par tour (best-of-N avant verification).
# JIO_CANDIDATES=3

# Taille minimale du panel pour conclure (borne byzantine n >= 3f+1 : 3 par defaut).
# En dessous, AUCUN consensus n'est atteignable, donc aucune livraison complete — et
# JIO le calcule AVANT de depenser des appels au lieu de le decouvrir apres.
# Ne baissez cette valeur que si vous acceptez de perdre la garantie de consensus.
# JIO_MIN_PANEL=3

# Budget de temps par mission, en secondes.
# JIO_TIME_BUDGET=600

# Muter l'artefact pour verifier que les regles peuvent ECHOUER (0/1).
# Recomande : 1. « Les tests passent » ne vaut que s'ils peuvent echouer.
# JIO_MUTATION_GATE=1
# Confronter chaque artefact a SA PROPRE documentation (exemples `>>>`, annotations).
# Un artefact qui contredit ce qu'il affirme est rejete et le modele recoit la
# contradiction exacte a corriger : mesure sur corpus documente, 2 defauts sur 4
# rattrapes, zero faux rejet. Desactiver rend le harness plus permissif, jamais
# plus sur.
# JIO_SELF_CHECK=true
# Comparer les candidats a EGALITE de preuves et AVOUER leurs desaccords : sans
# cela, le candidat livre depend de l'ORDRE de generation, et un desaccord reel
# passe en silence. Aucun appel de modele supplementaire (les candidats sont deja
# payes) ; le desaccord est SIGNALE, jamais bloquant.
# JIO_DIFFERENTIAL=true

# Traduire les regles de la specification en TEMOINS EXECUTABLES quand la mission
# n'en fournit aucun — le cas de toute mission reelle. Sans cela, la seule preuve
# disponible est la coherence de l'artefact avec sa propre documentation, et le
# moteur ne peut que s'abstenir : les regles restent des slogans. Cout : UN appel de
# modele, une fois par mission. Les tests ecrits par le modele passent une porte de
# securite ; un temoin que TOUS les candidats echouent est declare NON PROUVE.
# JIO_WITNESS=true

# Bibliotheque de temoins : les traductions DEJA VALIDEES par une livraison prouvee
# sont conservees, et la prochaine mission identique ne demande plus rien au modele
# (cout de traduction : zero). Seule une livraison DELIVERED alimente la memoire ;
# une abstention ou une reserve ne prouve rien, donc elle n'y transmet rien. Le
# fichier est verifie par chaine de hachage : edite a la main, il est mis en
# quarantaine et JAMAIS applique. Chemin par defaut : <etat>/temoins.jsonl.
# JIO_WITNESS_LIB=.jio/temoins.jsonl

# Poids du cout dans la recompense du routeur de confiance.
#   0.00 = ne jamais economiser  ·  0.35 = equilibre (defaut du code)
#   1.00 = economie maximale
# Laisse commente : la valeur par defaut du code s'applique.
# JIO_COST_WEIGHT=0.35

# --------------------------------------------------------------------------- #
# 6. Journalisation et reproductibilite
# --------------------------------------------------------------------------- #

# Dossier d'etat (journal, memoire, routeur) — les trois variables suivantes
# ne servent qu'a les deplacer separement.
# JIO_STATE=.jio

# Emplacement du journal append-only (chaine de hachage verifiable).
# JIO_JOURNAL=.jio/journal.jsonl

# Emplacement de la memoire des echecs (jamais repayer deux fois la meme erreur).
# JIO_MEMORY=.jio/failures.jsonl

# Etat du routeur de confiance (bandit UCB1).
# JIO_TRUST=.jio/trust.json

# Timeout par verification, en secondes, pour `jio scan`.
# JIO_SCAN_TIMEOUT=20

# Analyseurs standards utilises par `jio scan`, regles de VRAIS BUGS uniquement
# (E9,F63,F7,F811,F82 — aucun reglage de style). Valeurs : auto (defaut),
# ruff, flake8, pyflakes, off. S'ils sont absents, le rapport le DIT au lieu de
# laisser croire que le code a ete passe au crible.
# Recommande : pip install ruff
# JIO_LINTERS=auto

# Trace de diagnostic du banc, quand une tache reussit mais que le systeme
# s'abstient : dit pourquoi il n'a pas livre. Utile pour comprendre un chiffre,
# jamais necessaire pour executer.
# JIO_DEBUG_BENCH=1

# Racine autorisee pour le serveur MCP : tout chemin hors de cette racine est
# REFUSE. Ne l'elargissez pas sans raison : un serveur d'outils qui lit
# n'importe quel fichier sur demande est une vulnerabilite.
# JIO_ROOT=.

# --------------------------------------------------------------------------- #
# 7. Securite — IL N'Y A RIEN A CONFIGURER ICI, ET C'EST VOULU
#
#    Deux variables figuraient a cet endroit : JIO_HOSTILE_CONTENT et
#    JIO_ALLOW_FETCH. Audit : AUCUN code ne les lit. Il n'existe aucun
#    interrupteur de securite a activer, et le projet n'ouvre aucun acces
#    reseau. Les laisser ici donnait l'illusion de pouvoir fermer une porte
#    inexistante — pire que de ne rien documenter.
#
#    La securite est donc une DOCTRINE NON DESACTIVABLE, pas un reglage :
#      · tout contenu de depot (fichiers, issues, README, tests, metadonnees de
#        dependances) est une DONNEE, jamais une instruction ;
#      · les agents declarent leurs permissions explicitement, et le
#        verificateur est en `edit: deny` ;
#      · le serveur MCP confine tout chemin sous JIO_ROOT ;
#      · les artefacts sont executes dans un bac a sable, sans reseau.
#
#    Pour relacher une de ces regles, il faut modifier le code et assumer le
#    changement en revue. C'est le but.
# --------------------------------------------------------------------------- #

# ----------- fin. `jio doctor` valide tout ceci et dit ce qui est actif. ------
