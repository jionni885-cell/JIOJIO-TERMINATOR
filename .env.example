# =========================================================================== #
# JIOJIO-TERMINATOR — configuration
#
# AUCUNE de ces variables n'est obligatoire. Sans rien configurer, le systeme
# fonctionne en simulation deterministe : les reponses sont simulees, la
# VERIFICATION est reelle. C'est ce qui permet de tout tester sans cle.
#
# Copiez ce fichier en `.env` et decommentez ce que vous utilisez.
# Le fichier `.env` ne doit JAMAIS etre commite (deja dans .gitignore).
# =========================================================================== #

# --------------------------------------------------------------------------- #
# 1. CLI externes (recommande : ce sont vos agents deja authentifies)
#
#    Rien a configurer ici. JIO detecte automatiquement les binaires presents
#    dans le PATH et les utilise en subprocess. Pour connaitre ceux qui sont
#    connus :
#        jio doctor
# --------------------------------------------------------------------------- #
#
#   opencode   ->  opencode run "<prompt>" --format json --agent jio
#   hermes     ->  hermes chat -q "<prompt>"
#   claude     ->  claude -p "<prompt>"
#   codex      ->  codex exec "<prompt>"
#   gemini     ->  gemini -p "<prompt>"
#   aider      ->  aider --message "<prompt>" --yes
#
#   Les agents et competences JIO correspondants sont generes par :
#        jio artifacts --write
#
#   Surcharge du chemin d'un binaire (si hors PATH) :
# JIO_BIN_OPENCODE=/usr/local/bin/opencode
# JIO_BIN_HERMES=/opt/hermes/bin/hermes

# --------------------------------------------------------------------------- #
# 2. API compatible OpenAI — couvre la quasi-totalite des fournisseurs
#
#    OpenRouter, OpenAI, DeepSeek, Groq, Together, vLLM, LM Studio, Ollama…
#    Il suffit de trois valeurs : base, cle, modele.
# --------------------------------------------------------------------------- #
# JIO_OPENAI_BASE=https://openrouter.ai/api/v1
# JIO_OPENAI_KEY=sk-or-v1-...
# JIO_OPENAI_MODEL=anthropic/claude-sonnet-4.5
#
# JIO_OPENAI_BASE=https://api.openai.com/v1
# JIO_OPENAI_KEY=sk-...
# JIO_OPENAI_MODEL=gpt-5.4
#
# JIO_OPENAI_BASE=https://api.deepseek.com/v1
# JIO_OPENAI_KEY=sk-...
# JIO_OPENAI_MODEL=deepseek-chat

# --------------------------------------------------------------------------- #
# 3. Modele LOCAL (Ollama, LM Studio, llama.cpp)
#
#    Aucune cle necessaire. C'est le mode le moins cher a l'usage et celui ou
#    le harness apporte le PLUS de gain : plus le modele est faible, plus la
#    verification vaut cher. C'est la promesse centrale du projet.
# --------------------------------------------------------------------------- #
# JIO_OLLAMA=http://localhost:11434/v1
# JIO_OPENAI_MODEL=qwen3:14b
#
# JIO_OLLAMA=http://localhost:1234/v1        # LM Studio
# JIO_OPENAI_MODEL=local-model

# --------------------------------------------------------------------------- #
# 4. Cles reconnues automatiquement (si vous preferiez les conventions usuelles)
#
#    Depuis JIO_OPENAI_BASE, l'une de ces cles suffit :
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=

# --------------------------------------------------------------------------- #
# 5. Reglages du harness
# --------------------------------------------------------------------------- #

# Risque d'erreur accepte par la porte conforme (alpha). 0.05 = 5 %.
# Plus petit = plus d'abstentions, plus de garantie.
# JIO_ALPHA=0.05

# Nombre de tours maximum de la boucle de correction.
# JIO_MAX_ROUNDS=5

# Candidats generes par tour (best-of-N avant verification).
# JIO_CANDIDATES=3

# Budget de temps par mission, en secondes.
# JIO_TIME_BUDGET=600

# Muter l'artefact pour verifier que les regles peuvent ECHOUER (0/1).
# Recomande : 1. « Les tests passent » ne vaut que s'ils peuvent echouer.
# JIO_MUTATION_GATE=1

# Poids du cout dans la recompense du routeur (0 = qualite d'abord).
# 0.00 = ne jamais economiser ; 0.35 = equilibre ; 1.00 = economie maximale.
JIO_COST_WEIGHT=0.00

# --------------------------------------------------------------------------- #
# 6. Journalisation et reproductibilite
# --------------------------------------------------------------------------- #

# Emplacement du journal append-only (chaine de hachage verifiable).
# JIO_JOURNAL=.jio/journal.jsonl

# Emplacement de la memoire des echecs (jamais repayer deux fois la meme erreur).
# JIO_MEMORY=.jio/failures.jsonl

# Etat du routeur de confiance (bandit UCB1).
# JIO_TRUST=.jio/trust.json

# Racine autorisee pour le serveur MCP : tout chemin hors de cette racine est
# REFUSE. Ne l'elargissez pas sans raison : un serveur d'outils qui lit
# n'importe quel fichier sur demande est une vulnerabilite.
# JIO_ROOT=.

# --------------------------------------------------------------------------- #
# 7. Securite
#
#    Par defaut, JIO traite TOUT contenu de depot comme HOSTILE : fichiers,
#    issues, README, tests, metadonnees de dependances. Le contenu est une
#    DONNEE, jamais une instruction. Mesure : >85 % de succes pour les
#    techniques d'injection adaptatives contre les outils de code agentiques.
# --------------------------------------------------------------------------- #

# Refuse toute commande provenant d'un fichier du depot sans confirmation.
# JIO_HOSTILE_CONTENT=1

# Refuse les acces reseau depuis les agents d'analyse de depot.
# JIO_ALLOW_FETCH=0

# ----------- fin. `jio doctor` valide tout ceci et dit ce qui est actif. ------
