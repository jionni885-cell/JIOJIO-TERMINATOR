.venv/
__pycache__/
*.pyc
.jio/
.pytest_cache/
*.egg-info/
build/
dist/

# Sauvegardes locales creees avant une reecriture automatique (garde d'ecriture des
# artefacts, et `jio chiffres --appliquer`). Elles servent a revenir en arriere ; elles
# n'ont pas leur place dans l'historique.
*.avant-jio
*.jio

# Un verrou est un etat d'execution, pas une preuve : il change a chaque campaigne et ne
# doit pas entrer dans l'histoire du depot (il a ete committe une fois, par `git add -A`).
*.verrou
